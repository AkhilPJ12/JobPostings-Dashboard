# Public read API credentials. The web app only calls curated read RPCs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Worker-only database credential for ingestion and enrichment.
SUPABASE_SERVICE_ROLE_KEY=

# Free fallback is the default. Install scripts/requirements-scraping.txt and
# run `scrapling install` to enable its stealth browser mode.
SCRAPING_FALLBACK=scrapling
SCRAPLING_PYTHON=python3
# Set true after `scrapling install` for stealth fallback on Node GETs.
SCRAPLING_BROWSER_READY=false
# On macOS, set true to use an installed Google Chrome instead of a downloaded browser.
SCRAPLING_REAL_CHROME=false

# Optional paid fallback. Used only if SCRAPING_FALLBACK=scrapingbee is selected.
# SCRAPING_FALLBACK=scrapingbee
# SCRAPINGBEE_API_KEY=
# SCRAPINGBEE_PREMIUM_PROXY=false

# Ollama Cloud. Keep this key in GitHub Actions secrets or local server environment.
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
AI_REQUESTS_PER_MINUTE=8
AI_MAX_REQUESTS_PER_DAY=1200
AI_MAX_REQUESTS_PER_RUN=200
